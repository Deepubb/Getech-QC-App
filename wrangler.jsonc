{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in Cloudflare.
  "name": "getech-qc-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Keep variables added in the Cloudflare dashboard when deploying from Git.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any app address (e.g. /evidence/...) opens the app, so reloading a screen works.
    "not_found_handling": "single-page-application",
    // Every request goes through the script first, so nothing is served before the team code.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      // The team master list. Cloudflare creates this storage on the first deploy.
      "binding": "MASTER"
    }
  ]
}
